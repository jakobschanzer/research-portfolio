#!/bin/bash

# Set target directory (HBB)
TARGET_DIR=$(pwd)

# Define directories to process
DIRS=(5 15 35 45 55 65 75 85 95)

# Max number of concurrent jobs
MAX_JOBS=9

# Function to check number of running jobs
function wait_for_slot() {
  while (( $(jobs -r | wc -l) >= MAX_JOBS )); do
    sleep 1
  done
}

# Loop through each directory
for dir in "${DIRS[@]}"; do
  wait_for_slot

  (
    echo "Starting job in directory $dir"

    # Enter directory
    cd ../$dir || { echo "Failed to enter directory $dir"; exit 1; }

    # Create prd.crdbox
    catdcd -o prd.crdbox -otype crdbox -xtc prd.xtc
    cp ../HBB/drive .
    cp ../HBB/top .
    # Run hb4 with input and output redirection
    ../HBB/hb4 < prd.crdbox > hb4.log 2>&1

    # Rename and move output
    mv dist.out dist.$dir
    cp dist.$dir ../HBB/

    # Clean up
#    rm prd.crdbox

    echo "Finished job in directory $dir"
  ) &
done

# Wait for all background jobs to finish
wait
echo "All jobs complete."

